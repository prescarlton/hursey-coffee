// Coffee fundraiser ordering system — data model.
// Prisma 7 uses the `prisma-client` generator; connection URL lives in prisma.config.ts.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A coffee (or other item) that can be ordered. The back-office edits the
/// name and price; the storefront lists all items.
model MenuItem {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  name       String
  priceCents Int
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]
}

/// A single parent's order. Payment happens off-site on RevTrak, so the app
/// doesn't track whether it's been paid.
model Order {
  id              String   @id @default(cuid())
  /// Short, human-readable order number customers reference at handoff
  /// (distinct from the long cuid). Sequence starts at 1001.
  orderNumber     Int      @unique @default(autoincrement())
  customerName    String
  /// Car details + parking space (1–8) for curbside pickup. Null on teacher
  /// orders, which are delivered to `teacherLocation` instead.
  carColor        String?
  carType         String?
  parkingSpace    Int?
  /// Where to deliver a teacher/staff order (e.g. "Room 12"). Non-null marks
  /// the order as a teacher order.
  teacherLocation String?
  totalCents      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items OrderItem[]
}

/// A line in an order. Name + unit price are snapshotted so historical orders stay
/// correct even if the menu item is later renamed, repriced, or removed.
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  menuItemId     String?
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable + SetNull: deleting a menu item preserves order history (name/price
  // are snapshotted above) by nulling this reference instead of blocking.
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
