# --- Database (Postgres) ---
# Local dev: run `pnpm prisma dev` and paste the URL it prints here,
# or use a hosted Postgres URL (Neon / Supabase / Vercel Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/hursey_coffee?schema=public"

# --- Stripe (test mode) ---
# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App ---
# Absolute base URL used to build Stripe success/cancel redirect URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Admin panel ---
# Shared password gating /admin. Pick a strong value in production.
ADMIN_PASSWORD="change-me"
